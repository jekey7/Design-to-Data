{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "GDS.json",
  "title": "Game Design Schema (GDS)",
  "description": "GDF 구조 규격. (1) LLM 플래너가 GDD → GDF 생성 시 준수해야 할 데이터 구조를 정의하고, (2) ajv 기반 L1 자동 검증기가 생성된 GDF의 스키마 적합성을 기계 검증하는 데 동일하게 사용된다.",
  "type": "object",
  "required": [
    "asset_manifest",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "asset_manifest": {
      "description": "GDF 전체에서 참조되는 에셋 이름을 사전 선언하는 목록. clip/sprite/prefab 참조가 실제로 존재할 때만 해당 목록에 선언한다. 컴포넌트 properties 내 clip/sprite 값은 반드시 이 목록 안에 있어야 한다. (참조 무결성은 Phase 3 커스텀 룰에서 검증).",
      "type": "object",
      "required": [
        "audio",
        "ui_sprites"
      ],
      "additionalProperties": false,
      "properties": {
        "audio": {
          "description": "AudioSource 컴포넌트의 clip 속성에서 참조할 오디오 에셋 이름 목록.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "ui_sprites": {
          "description": "Image 컴포넌트의 sprite 속성에서 참조할 UI 스프라이트 에셋 이름 목록.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "prefabs": {
          "description": "컴포넌트 properties에서 'prefab:' prefix로 참조할 프리팹 에셋 이름 목록. 선택 필드. (RULE-R05)",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "$comment": "확장 포인트 (A-1): Tier 3 GDD 대응 시 meshes / textures 카테고리 추가 예정."
    },
    "scenes": {
      "description": "GDF가 기술하는 Unity 씬 목록. 최소 1개 이상이어야 한다.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Scene"
      }
    }
  },
  "$defs": {
    "Scene": {
      "description": "단일 Unity 씬을 기술하는 객체.",
      "type": "object",
      "required": [
        "scene_name",
        "gameObjects"
      ],
      "additionalProperties": false,
      "properties": {
        "scene_name": {
          "description": "Unity 씬 파일명과 일치해야 하는 씬 식별자. 공백·특수문자 금지 (S-1 처리).",
          "type": "string",
          "pattern": "^[A-Za-z0-9_]+$",
          "minLength": 1
        },
        "gameObjects": {
          "description": "씬을 구성하는 게임오브젝트 목록.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/GameObject"
          }
        }
      }
    },
    "GameObject": {
      "description": "Unity 게임오브젝트 하나를 기술하는 객체. layer 값에 따라 transform 또는 rectTransform 블록이 선택적으로 필수가 된다.",
      "type": "object",
      "required": [
        "uid",
        "name",
        "tag",
        "layer",
        "parent_uid",
        "components"
      ],
      "properties": {
        "uid": {
          "description": "씬 내에서 고유한 게임오브젝트 식별자. snake_case 소문자만 허용.",
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "minLength": 1
        },
        "name": {
          "description": "Unity Hierarchy에 표시되는 게임오브젝트 이름.",
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "description": "Unity 태그. 기본값 'Untagged' (C-1 처리: 모든 gameObject에 필수).",
          "type": "string",
          "minLength": 1,
          "default": "Untagged"
        },
        "layer": {
          "description": "Unity 레이어. 기본값 'Default'. 'UI' 지정 시 rectTransform 블록이 필수가 된다.",
          "type": "string",
          "minLength": 1,
          "default": "Default"
        },
        "parent_uid": {
          "description": "부모 게임오브젝트의 uid. 씬 루트 오브젝트는 null. 참조 무결성(존재 여부)은 Phase 3 커스텀 룰에서 검증.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "components": {
          "description": "이 게임오브젝트에 부착된 컴포넌트 목록. 최소 1개 이상 필수.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/Component"
          }
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "rectTransform": {
          "$ref": "#/$defs/RectTransform"
        },
        "type": {
          "description": "DEPRECATED (G-1 처리): Camera 오브젝트 판별은 Camera 컴포넌트 보유 여부로 대체. 이 필드는 하위 호환성을 위해 허용하나 신규 GDF에서는 사용하지 않는다.",
          "type": "string"
        },
        "active": {
          "description": "Unity GameObject의 활성화 상태. false는 비활성(SetActive(false)) 상태를 나타낸다. 생략 시 true로 간주.",
          "type": "boolean",
          "default": true
        }
      },
      "if": {
        "properties": {
          "layer": {
            "const": "UI"
          }
        },
        "required": [
          "layer"
        ]
      },
      "then": {
        "required": [
          "rectTransform"
        ],
        "properties": {
          "rectTransform": {
            "$ref": "#/$defs/RectTransform"
          },
          "transform": false
        },
        "$comment": "UI 우선순위: layer=UI 오브젝트는 rectTransform만 허용."
      },
      "else": {
        "required": [
          "transform"
        ],
        "properties": {
          "transform": {
            "$ref": "#/$defs/Transform"
          },
          "rectTransform": false
        },
        "$comment": "Non-UI 오브젝트는 transform만 허용."
      }
    },
    "Transform": {
      "description": "Non-UI 게임오브젝트의 3D 공간 변환 정보.",
      "type": "object",
      "required": [
        "position",
        "rotation",
        "scale"
      ],
      "additionalProperties": false,
      "properties": {
        "position": {
          "$ref": "#/$defs/Vector3"
        },
        "rotation": {
          "$ref": "#/$defs/Vector3"
        },
        "scale": {
          "$ref": "#/$defs/Vector3"
        }
      }
    },
    "RectTransform": {
      "description": "UI 게임오브젝트의 2D 레이아웃 변환 정보. anchoredPosition은 3요소 배열(z=0 고정 관례).",
      "type": "object",
      "required": [
        "anchoredPosition",
        "sizeDelta",
        "pivot",
        "anchorMin",
        "anchorMax"
      ],
      "additionalProperties": false,
      "properties": {
        "anchoredPosition": {
          "$ref": "#/$defs/Vector3"
        },
        "sizeDelta": {
          "$ref": "#/$defs/Vector2"
        },
        "pivot": {
          "$ref": "#/$defs/Vector2"
        },
        "anchorMin": {
          "$ref": "#/$defs/Vector2"
        },
        "anchorMax": {
          "$ref": "#/$defs/Vector2"
        },
        "offsetMin": {
          "description": "선택 필드. stretch anchor(anchorMin != anchorMax) 사용 시 명시.",
          "$ref": "#/$defs/Vector2"
        },
        "offsetMax": {
          "description": "선택 필드. stretch anchor(anchorMin != anchorMax) 사용 시 명시.",
          "$ref": "#/$defs/Vector2"
        }
      }
    },
    "Component": {
      "description": "게임오브젝트에 부착된 단일 컴포넌트. properties와 events는 독립 선택 필드로 양립 허용 (CP-1 처리). isCustomScript=false인 주요 빌트인 컴포넌트는 if/then으로 properties 서브스키마를 강제한다 (CP-2).",
      "type": "object",
      "required": [
        "name",
        "isCustomScript"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Unity 컴포넌트 클래스명 또는 커스텀 스크립트 클래스명.",
          "type": "string",
          "minLength": 1
        },
        "isCustomScript": {
          "description": "true: 프로젝트 내 커스텀 C# 스크립트. false: Unity 빌트인 컴포넌트.",
          "type": "boolean"
        },
        "properties": {
          "description": "컴포넌트 프로퍼티 키-값 맵. events와 동시 보유 가능 (CP-1). 값이 '@'로 시작하는 문자열은 씬 내 GameObject 참조를 의미한다 (예: \"@obj_score_text\").",
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^@[a-z0-9_]+$",
                "description": "GameObject 참조. '@' prefix + uid."
              },
              {
                "type": "string",
                "not": {
                  "pattern": "^@[a-z0-9_]+$"
                }
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array"
              },
              {
                "type": "object"
              }
            ]
          }
        },
        "events": {
          "description": "컴포넌트 이벤트 바인딩 맵. properties와 동시 보유 가능 (CP-1).",
          "type": "object",
          "properties": {
            "onClick": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EventBinding"
              }
            }
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/EventBinding"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "name": {
                "const": "MeshFilter"
              },
              "isCustomScript": {
                "const": false
              }
            },
            "required": [
              "name",
              "isCustomScript"
            ]
          },
          "then": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "$ref": "#/$defs/MeshFilterProperties"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "MeshRenderer"
              },
              "isCustomScript": {
                "const": false
              }
            },
            "required": [
              "name",
              "isCustomScript"
            ]
          },
          "then": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "$ref": "#/$defs/MeshRendererProperties"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "ParticleSystem"
              },
              "isCustomScript": {
                "const": false
              }
            },
            "required": [
              "name",
              "isCustomScript"
            ]
          },
          "then": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "$ref": "#/$defs/ParticleSystemProperties"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "Camera"
              },
              "isCustomScript": {
                "const": false
              }
            },
            "required": [
              "name",
              "isCustomScript"
            ]
          },
          "then": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "$ref": "#/$defs/CameraProperties"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "Light"
              },
              "isCustomScript": {
                "const": false
              }
            },
            "required": [
              "name",
              "isCustomScript"
            ]
          },
          "then": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "$ref": "#/$defs/LightProperties"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "AudioSource"
              },
              "isCustomScript": {
                "const": false
              }
            },
            "required": [
              "name",
              "isCustomScript"
            ]
          },
          "then": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "$ref": "#/$defs/AudioSourceProperties"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "Canvas"
              },
              "isCustomScript": {
                "const": false
              }
            },
            "required": [
              "name",
              "isCustomScript"
            ]
          },
          "then": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "$ref": "#/$defs/CanvasProperties"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "CanvasScaler"
              },
              "isCustomScript": {
                "const": false
              }
            },
            "required": [
              "name",
              "isCustomScript"
            ]
          },
          "then": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "$ref": "#/$defs/CanvasScalerProperties"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "Image"
              },
              "isCustomScript": {
                "const": false
              }
            },
            "required": [
              "name",
              "isCustomScript"
            ]
          },
          "then": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "$ref": "#/$defs/ImageProperties"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {
                "const": "TextMeshProUGUI"
              },
              "isCustomScript": {
                "const": false
              }
            },
            "required": [
              "name",
              "isCustomScript"
            ]
          },
          "then": {
            "required": [
              "properties"
            ],
            "properties": {
              "properties": {
                "$ref": "#/$defs/TextMeshProUGUIProperties"
              }
            }
          }
        }
      ]
    },
    "EventBinding": {
      "description": "단일 이벤트 핸들러 바인딩 정의.",
      "type": "object",
      "required": [
        "target_uid",
        "component",
        "method",
        "param"
      ],
      "additionalProperties": false,
      "properties": {
        "target_uid": {
          "description": "이벤트 수신 게임오브젝트의 uid. '@' prefix 필수 (E-1 처리). 참조 무결성은 Phase 3 커스텀 룰에서 검증.",
          "type": "string",
          "pattern": "^@[a-z0-9_]+$"
        },
        "component": {
          "description": "이벤트를 수신할 컴포넌트 클래스명.",
          "type": "string",
          "minLength": 1
        },
        "method": {
          "description": "호출할 메서드명.",
          "type": "string",
          "minLength": 1
        },
        "param": {
          "description": "메서드에 전달할 인자. null 포함 primitive 타입 허용 (E-2 처리).",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Vector2": {
      "description": "2D 좌표 또는 크기를 표현하는 [x, y] 배열.",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "Vector3": {
      "description": "3D 좌표, 회전, 스케일을 표현하는 [x, y, z] 배열.",
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "MeshFilterProperties": {
      "description": "MeshFilter 컴포넌트 프로퍼티. mesh는 반드시 비어 있지 않은 메시 이름이어야 한다. GDD에 메시 에셋명이 없으면 적절한 Unity primitive 메시명(기본값: Cube)을 사용한다.",
      "type": "object",
      "required": [
        "mesh"
      ],
      "additionalProperties": false,
      "properties": {
        "mesh": {
          "description": "참조할 메시 에셋명. GDD에 명시되지 않은 경우 Cube 등 적절한 Unity primitive 메시명을 사용한다.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "MeshRendererProperties": {
      "description": "MeshRenderer 컴포넌트 프로퍼티. shaderName 필수, 렌더 파이프라인에 맞는 셰이더명을 사용한다 (RULE-G05).",
      "type": "object",
      "required": [
        "shaderName"
      ],
      "additionalProperties": true,
      "properties": {
        "shaderName": {
          "description": "적용할 셰이더 이름. 예: 'Standard', 'Universal Render Pipeline/Lit'.",
          "type": "string",
          "minLength": 1
        },
        "materialColor": {
          "description": "머티리얼 색상 (hex). 선택 필드.",
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "CameraProperties": {
      "description": "Camera 컴포넌트 프로퍼티.",
      "type": "object",
      "required": [
        "fieldOfView"
      ],
      "additionalProperties": true,
      "properties": {
        "fieldOfView": {
          "description": "카메라 수직 시야각 (도 단위). 일반적으로 60.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 180
        }
      }
    },
    "LightProperties": {
      "description": "Light 컴포넌트 프로퍼티.",
      "type": "object",
      "required": [
        "type",
        "intensity"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "조명 유형.",
          "type": "string",
          "enum": [
            "Directional",
            "Point",
            "Spot",
            "Area"
          ]
        },
        "intensity": {
          "description": "조명 강도. 0 이상.",
          "type": "number",
          "minimum": 0
        }
      }
    },
    "AudioSourceProperties": {
      "description": "AudioSource 컴포넌트 프로퍼티. clip은 생략 가능하며, clip을 명시하면 asset_manifest.audio에 선언된 이름이어야 한다 (RULE-R03).",
      "type": "object",
      "required": [
        "loop"
      ],
      "additionalProperties": true,
      "properties": {
        "clip": {
          "description": "재생할 오디오 클립 이름. 생략 가능하며, 명시할 경우 asset_manifest.audio에 선언된 이름과 일치해야 한다.",
          "type": "string",
          "minLength": 1
        },
        "loop": {
          "description": "반복 재생 여부. BGM: true, SFX: false (RULE-G04).",
          "type": "boolean"
        }
      }
    },
    "CanvasProperties": {
      "description": "Canvas 컴포넌트 프로퍼티.",
      "type": "object",
      "required": [
        "renderMode",
        "sortingOrder"
      ],
      "additionalProperties": false,
      "properties": {
        "renderMode": {
          "description": "캔버스 렌더 모드.",
          "type": "string",
          "enum": [
            "ScreenSpaceOverlay",
            "ScreenSpaceCamera",
